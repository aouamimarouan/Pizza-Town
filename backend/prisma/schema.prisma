generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExtraItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  category     String   @db.VarChar(100)
  price        Decimal? @default(1.00) @db.Decimal(10, 2)
  is_mandatory Boolean? @default(false)
}

model menuitems {
  item_id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @db.VarChar(255)
  category     String?      @db.VarChar(100)
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  image_url    String?
  is_available Boolean      @default(true)
  orderitems   orderitems[]
}

model orderitems {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String    @db.Uuid
  menu_item_id   String    @db.Uuid
  quantity       Int
  subtotal       Decimal   @db.Decimal(10, 2)
  customizations Json?
  menuitems      menuitems @relation(fields: [menu_item_id], references: [item_id], onDelete: Cascade)
  orders         orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
}

model orders {
  order_id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String       @db.Uuid
  total_price      Decimal      @db.Decimal(10, 2)
  status           String?      @db.VarChar(50)
  delivery_type    String?      @db.VarChar(50)
  delivery_address String?
  delivery_fee        Decimal?     @default(0.00) @db.Decimal(10, 2)
  cancellation_reason String?
  pickup_time         String?
  created_at          DateTime     @default(now()) @db.Timestamp(6)
  orderitems          orderitems[]
  users               users        @relation(fields: [user_id], references: [user_id])
  reviews             reviews?
}

model reservations {
  res_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?  @db.Uuid
  full_name    String   @db.VarChar(255)
  email        String?  @db.VarChar(255)
  phone_number String   @db.VarChar(20)
  res_date     DateTime @db.Date
  res_time     DateTime @db.Time(6)
  guests       Int
  status       String?  @db.VarChar(50)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  users        users?   @relation(fields: [user_id], references: [user_id])
}

model users {
  user_id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name     String?        @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  password_hash String
  phone_number  String?        @db.VarChar(20)
  address       String?
  role          String?        @db.VarChar(50)
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  orders        orders[]
  reservations  reservations[]
  reviews       reviews[]
  audit_logs    audit_logs[]   @relation("AdminAuditLogs")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String?  @db.Uuid
  users       users?   @relation("AdminAuditLogs", fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  details     Json?
  created_at  DateTime @default(now()) @db.Timestamp(6)
}

model reviews {
  review_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String   @unique @db.Uuid
  user_id    String   @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  orders     orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}
