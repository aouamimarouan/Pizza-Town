# =============================================================================
#  Pizza Town — Sample Environment File
# =============================================================================
#  HOW TO USE:
#    Copy this file to `.env` in the project root and fill in your values.
#    → cp .env.example .env
#
#  ⚠️  IMPORTANT — Docker networking:
#    When running via docker-compose, the database host is the SERVICE NAME
#    ("db"), NOT "localhost". The DATABASE_URL below is correct for Docker.
#    If you ever run the backend locally (outside Docker), change the host
#    back to "localhost" and match your local Postgres port.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=26072022
POSTGRES_DB=pizzatown

# ── Prisma / Backend ─────────────────────────────────────────────────────────
# "db" is the Docker Compose service name
DATABASE_URL="postgresql://postgres:26072022@db:5432/pizzatown"

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Must be prefixed with VITE_ to be exposed to the browser bundle
VITE_API_URL=http://localhost:5000

PORT=5000
JWT_SECRET=52aad34c2e41ff0127910339c8d42d6791af1c72dd24fdb57d011b284d3b5dd1
NODE_ENV=production