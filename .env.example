# =============================================================================
#  Pizza Town — Sample Environment File
# =============================================================================
#  HOW TO USE:
#    Copy this file to `.env` in the project root and fill in your values.
#    → cp .env.example .env
#
#  ⚠️  IMPORTANT — Docker networking:
#    When running via docker-compose, the database host is the SERVICE NAME
#    ("db"), NOT "localhost". The DATABASE_URL below is correct for Docker.
#    If you ever run the backend locally (outside Docker), change the host
#    back to "localhost" and match your local Postgres port.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pizzatown

# ── Prisma / Backend ─────────────────────────────────────────────────────────
# "db" is the Docker Compose service name — equals "localhost" when running locally
DATABASE_URL="postgresql://postgres:changeme@db:5432/pizzatown"

# Backend server port
PORT=5000

# Node environment
NODE_ENV=development

# JSON Web Token secret — replace with a long random string in production!
JWT_SECRET=replace_this_with_a_long_random_secret_string

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Must be prefixed with VITE_ to be exposed to the browser bundle
VITE_API_URL=http://localhost:5000
